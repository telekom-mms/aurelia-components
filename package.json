{
	"name": "mreiche-aurelia-components",
	"version": "2.0.2",
	"description": "Common useful components for the Aurelia 2 framework",
	"repository": "https://github.com/telekom-mms/aurelia-components.git",
	"author": "Mike Reiche <mike@reiche.world>",
	"scripts": {
		"build": "tsc",
		"webpack": "webpack --mode=production",
		"test": "jest"
	},
	"license": "MIT",
	"devDependencies": {
		"@aurelia/i18n": "2.0.0-rc.2",
		"@aurelia/platform-browser": "2.0.0-rc.2",
		"@aurelia/testing": "2.0.0-rc.2",
		"@aurelia/ts-jest": "2.0.0-rc.2",
		"@types/bootstrap": "^5.2.11",
		"@types/jest": "^30.0.0",
		"@types/sanitize-html": "^2.16.1",
		"apexcharts": "^6.7.0",
		"aurelia": "2.0.0-rc.2",
		"echarts": "^6.1.0",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"jest-transform-stub": "^2.0.0",
		"moment": "^2.30.1",
		"momentjs": "^2.0.0",
		"sanitize-html": "^2.17.6",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"bootstrap": "^5.1.3",
		"echarts": "^5.5.0",
		"moment": "^2.30.1",
		"moment-duration-format": "^2.3.2",
		"sanitize-html": "^2.13.0",
		"ts-md5": "^1.2.7",
        "aurelia-validation": "^2.0.0-rc.2"
	},
	"peerDependenciesMeta": {
		"apexcharts": {
			"optional": true
		},
		"aurelia-templating": {
			"optional": true
		},
		"aurelia-validation": {
			"optional": true
		},
		"bootstrap": {
			"optional": true
		},
		"echarts": {
			"optional": true
		},
		"moment": {
			"optional": true
		},
		"moment-duration-format": {
			"optional": true
		},
		"ts-md5": {
			"optional": true
		},
		"sanitize-html": {
			"optional": true
		}
	},
	"jest": {
		"testMatch": [
			"<rootDir>/test/**/*.spec.ts"
		],
		"testEnvironment": "jsdom",
		"transform": {
			"\\.(css|less|sass|scss|styl|jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "jest-transform-stub",
			"\\.(ts|html)$": "@aurelia/ts-jest",
			"\\.js$": "@aurelia/ts-jest"
		},
		"transformIgnorePatterns": [
			"/node_modules/\\.pnpm/(?!(htmlparser2|domhandler|domutils|domelementtype|dom-serializer|entities)@)"
		],
		"collectCoverage": true,
		"collectCoverageFrom": [
			"src/**/*.ts",
			"!src/**/*.d.ts"
		]
	},
	"packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
