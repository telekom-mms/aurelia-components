{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "esModuleInterop": true,
    "stripInternal": true,
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "declaration": true,
    // TypeScript 6 no longer auto-includes node_modules/@types; anything global
    // has to be requested here. "src" needs neither entry -- both are kept so
    // that a test-side type check can extend this config unchanged.
    "types": [
      "jest",
      "node"
    ],
    // TypeScript 6 turns "strict" on by default. The explicit strict* flags
    // below stay in effect; this only keeps the pre-6 baseline for the rest.
    "strict": false,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "noPropertyAccessFromIndexSignature":  true,
    "strictBindCallApply":  true,
    "strictFunctionTypes": true,
    "useUnknownInCatchVariables": true,
    "importHelpers": true,
    "sourceMap": true,
    "lib": [
      "es2020",
      "es2021.intl",
      "dom"
    ],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
