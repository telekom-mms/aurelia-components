{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "esModuleInterop": true,
    "stripInternal": true,
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "declaration": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "noPropertyAccessFromIndexSignature":  true,
    "strictBindCallApply":  true,
    "strictFunctionTypes": true,
    "useUnknownInCatchVariables": true,
    "importHelpers": true,
    "sourceMap": true,
    "lib": [
      "es2020",
      "es2021.intl",
      "dom"
    ],
    "rootDir": ".",
    "outDir": "dist"
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
